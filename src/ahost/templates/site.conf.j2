# Generated by AHost from {{ manifest_path }}. Do not edit: the next apply overwrites it.
{% if app.proxy.raw_http %}
# --- raw_http ---
{{ app.proxy.raw_http | trim }}
{% endif %}
server {
    listen 80;
{% if ipv6 %}    listen [::]:80;
{% endif %}    server_name {{ app.domains | join(' ') }};
    access_log {{ log_dir }}/{{ app.name }}.access.log;
    error_log  {{ log_dir }}/{{ app.name }}.error.log;

    location ^~ /.well-known/acme-challenge/ {
        root {{ webroot }};
        default_type text/plain;
    }
{% if app.proxy.http_redirect and https_servers %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
{{ locations | indent(4, true) }}
{% endif %}}
{% for srv in https_servers %}
server {
    listen 443 ssl;
{% if ipv6 %}    listen [::]:443 ssl;
{% endif %}    server_name {{ srv.domains | join(' ') }};
    access_log {{ log_dir }}/{{ app.name }}.access.log;
    error_log  {{ log_dir }}/{{ app.name }}.error.log;

    ssl_certificate     {{ live_dir }}/{{ srv.cert }}/fullchain.pem;
    ssl_certificate_key {{ live_dir }}/{{ srv.cert }}/privkey.pem;
{% if options_file %}    include {{ options_file }};
{% endif %}{% if dhparam %}    ssl_dhparam {{ dhparam }};
{% endif %}{% if app.proxy.max_body %}
    client_max_body_size {{ app.proxy.max_body }};
{% endif %}{% if app.proxy.gzip %}
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2;
{% endif %}
{{ locations | indent(4, true) }}
{% if app.proxy.raw_server %}
    # --- raw_server ---
{{ app.proxy.raw_server | trim | indent(4, true) }}
{% endif %}}
{% endfor %}

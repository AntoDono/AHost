# Generated by AHost. Explicit HTTPS catch-all: unknown hosts (and the bare IP) get the connection closed,
# instead of whichever site nginx happened to load first.
server {
    listen 443 ssl default_server;
{% if ipv6 %}    listen [::]:443 ssl default_server;
{% endif %}    server_name _;
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
    access_log off;
    return 444;
}

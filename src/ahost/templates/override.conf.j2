# Generated by AHost from {{ manifest_path }}. Do not edit: the next apply overwrites it.
[Unit]
Description=AHost {{ app.name }}{% if pid_label %} ({{ pid_label }}){% endif %}{% if app.description %}: {{ app.description }}{% endif %}
{% for u in after %}After={{ u }}
{% endfor %}{% for u in wants %}Wants={{ u }}
{% endfor %}{% if part_of %}PartOf={{ part_of }}
{% endif %}
[Service]
User={{ user }}
{% if app.group %}Group={{ app.group }}
{% endif %}WorkingDirectory={{ workdir }}
Type={{ proc.type }}
Restart={{ proc.restart }}
RestartSec={{ proc.restart_sec }}
KillMode={{ proc.kill_mode }}
{% if proc.stop_timeout is not none %}TimeoutStopSec={{ proc.stop_timeout }}
{% endif %}{% if proc.start_timeout is not none %}TimeoutStartSec={{ proc.start_timeout }}
{% endif %}{% if proc.reload %}ExecReload={{ proc.reload }}
{% endif %}# Environment precedence (systemd): files override Environment=; later files override earlier ones.
EnvironmentFile=
{% for f in env_files %}EnvironmentFile={{ f }}
{% endfor %}EnvironmentFile=-{{ ahost_env }}
{% for line in environment %}Environment={{ line }}
{% endfor %}{% if proc.memory_max %}MemoryMax={{ proc.memory_max }}
{% endif %}{% if proc.cpu_quota %}CPUQuota={{ proc.cpu_quota }}
{% endif %}{% for k, v in extra %}{{ k }}={{ v }}
{% endfor %}{% if sandbox %}# sandbox: {{ app.sandbox.level }}
{% for line in sandbox %}{{ line }}
{% endfor %}{% endif %}
